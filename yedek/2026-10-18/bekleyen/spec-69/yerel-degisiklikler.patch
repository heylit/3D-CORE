+def _kutle_denetle(ad: str, k: Kutle) -> tuple[float, np.ndarray, np.ndarray]:
+    """m > 0, c (3,), J (3,3) simetrik ve yarı pozitif tanımlı (noktasal kütle J = 0 olabilir)."""
+    m = float(k.m)
+    c = np.asarray(k.c, dtype=float)
+    J = np.asarray(k.J, dtype=float)
+    if not (math.isfinite(m) and m > 0):
+        raise ModelError(f"Bileşen '{ad}': kütle m > 0 olmalı (m={m})")
+    if c.shape != (3,) or not np.all(np.isfinite(c)):
+        raise ModelError(f"Bileşen '{ad}': kütle merkezi c sonlu (3,) olmalı")
+    if J.shape != (3, 3) or not np.all(np.isfinite(J)):
+        raise ModelError(f"Bileşen '{ad}': atalet J sonlu (3, 3) olmalı")
+    olcek = max(1.0, float(np.max(np.abs(J))))
+    if np.max(np.abs(J - J.T)) > _TOL_J * olcek:
+        raise ModelError(f"Bileşen '{ad}': atalet J simetrik değil")
