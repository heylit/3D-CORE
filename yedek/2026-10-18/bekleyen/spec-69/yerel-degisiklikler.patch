+def _cerceve(asm: Assembly, j: Joint, side: str) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """Eklem ucunun dünya çerçevesi (p, z, x)."""
+    o, z, x = j.axis_frame(side)
+    ref = j.a if side == "a" else j.b
+    T = asm.component(ref.component).T
+    R = T[:3, :3]
+    return R @ o + T[:3, 3], R @ z, R @ x
+
+
+def _surucu_satiri(asm: Assembly, j: Joint, unknowns: list[str]) -> np.ndarray:
+    """Sürücü koordinatının hız satırı: q̇ = a · ẋ.
+
+    Döner:  θ̇ = z_a · (ω_b − ω_a)                                         (rad/s)
+    Kayar:  s = (p_b − p_a)·z_a  →  ṡ = z_a·(ṗ_b − ṗ_a) + (p_b − p_a)·(ω_a × z_a)
+            ṗ = ṫ + ω × (p − t)  ⇒  ∂ṡ/∂ω_b = (p_b − t_b) × z_a,
+            ∂ṡ/∂ω_a = −(p_a − t_a) × z_a + z_a × (p_b − p_a)
+    """
+    pa, za, _ = _cerceve(asm, j, "a")
+    pb, _, _ = _cerceve(asm, j, "b")
+    satir = np.zeros(6 * len(unknowns))
+
+    def ekle(ad: str, dt: np.ndarray, dw: np.ndarray) -> None:
+        if ad in unknowns:
+            i = unknowns.index(ad)
+            satir[6 * i : 6 * i + 3] += dt
+            satir[6 * i + 3 : 6 * i + 6] += dw
+
+    a, b = j.a.component, j.b.component
+    if j.kind is JointKind.REVOLUTE:
+        ekle(b, np.zeros(3), za)
+        ekle(a, np.zeros(3), -za)
+    else:  # PRISMATIC
+        ta, tb = asm.component(a).T[:3, 3], asm.component(b).T[:3, 3]
+        ekle(b, za, np.cross(pb - tb, za))
+        ekle(a, -za, -np.cross(pa - ta, za) + np.cross(za, pb - pa))
+    return satir
+
+
+@dataclass
+class _Satirlar:
+    """A = [mate satırları; eklem satırları; sürücü satırları] ve eklemlerin satır aralıkları."""
+
+    A: np.ndarray
+    eklem: dict[str, slice]
+    surucu: slice
+
+
+def _satirlar(asm: Assembly, unknowns: list[str], suruculer: list[Joint]) -> _Satirlar:
+    n = 6 * len(unknowns)
+    bloklar = [np.zeros((0, n))]
+    bloklar += [mate_jacobian(asm, m, unknowns) for m in asm.mates]
+    i0 = sum(b.shape[0] for b in bloklar)
+    eklem = {}
+    for j in asm.joints:
+        Jj = joint_jacobian(asm, j, unknowns)
+        eklem[j.name] = slice(i0, i0 + Jj.shape[0])
+        i0 += Jj.shape[0]
+        bloklar.append(Jj)
+    bloklar += [_surucu_satiri(asm, j, unknowns)[None, :] for j in suruculer]
+    return _Satirlar(np.vstack(bloklar), eklem, slice(i0, i0 + len(suruculer)))
+
+
+def _qdot(s: Surucu, j: Joint, t: float, h: float) -> float:
+    """Sürücü hızı (beş noktalı fark); döner eklemde rad/s, kayarda mm/s."""
+    qd = sum(w * float(s.q(t + k * h)) for k, w in _FARK) / h
+    return math.radians(qd) if j.kind is JointKind.REVOLUTE else qd
+
+
+def _hiz(asm: Assembly, unknowns, suruculer, joints, t: float, h: float) -> np.ndarray:
+    """[Φ_q; Φ_q,sürücü] ẋ = [0; q̇] çözümü (en küçük kareler; tutarlı sistemde tam)."""
+    S = _satirlar(asm, unknowns, joints)
+    b = np.zeros(S.A.shape[0])
+    b[S.surucu] = [_qdot(s, j, t, h) for s, j in zip(suruculer, joints, strict=True)]
+    return np.linalg.lstsq(S.A, b, rcond=None)[0]
+
+
+def _konum(asm: Assembly, suruculer, t: float) -> dict[str, np.ndarray]:
+    """SPEC 33 drive ile t anındaki konum (mevcut konumdan başlar)."""
+    degerler = {s.joint: float(s.q(t)) for s in suruculer}
+    try:
+        return drive(asm, degerler, tol=_TOL_SURME).T
+    except AssyError as e:
+        raise AssyError(f"t = {t:.9g} s, sürücüler {degerler}: {e}") from e
+
+
+def _ata(asm: Assembly, T: Mapping[str, np.ndarray]) -> None:
