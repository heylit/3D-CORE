+            raise ModelError(f"Bileşen '{c.name}': malzeme {c.material!r} kütüphanede yok") from e
+        rho = getattr(malzeme, "rho", None)
+        if rho is None:
+            raise ModelError(f"Bileşen '{c.name}': malzeme {c.material!r} yoğunluğu (rho) yok")
+        mp = mass_props(parts[c.name], float(rho))
+        kutleler[c.name] = Kutle(
+            m=float(mp.m), c=np.asarray(mp.com, dtype=float), J=np.asarray(mp.I, dtype=float)
+        )
+    return kutleler
