+def _genel_kuvvet(asm, unknowns, kutle, xd, xdd, g, dis_kuvvetler, t) -> np.ndarray:
+    """Kısıtların sağlaması gereken genelleştirilmiş kuvvet Q_i = [F_i, r_i × F_i + M_i]."""
+    Q = np.zeros(6 * len(unknowns))
+    for i, ad in enumerate(unknowns):
+        m, c, J = kutle[ad]
+        R = asm.component(ad).T[:3, :3]
+        r = R @ c
+        Jw = R @ J @ R.T
+        w, wd = xd[6 * i + 3 : 6 * i + 6], xdd[6 * i + 3 : 6 * i + 6]
+        tdd = xdd[6 * i : 6 * i + 3]
+        a_c = tdd + np.cross(wd, r) + np.cross(w, np.cross(w, r))
+        F_dis, M_dis = np.zeros(3), np.zeros(3)
+        if ad in dis_kuvvetler:
+            F_dis, M_dis = (np.asarray(v, dtype=float) for v in dis_kuvvetler[ad](t))
+        F = m * a_c - m * g - F_dis
+        M = Jw @ wd + np.cross(w, Jw @ w) - M_dis
+        Q[6 * i : 6 * i + 3] = F
+        Q[6 * i + 3 : 6 * i + 6] = np.cross(r, F) + M
+    return Q
+
+
+def _eklem_tepkisi(
+    asm, j: Joint, unknowns, Aj: np.ndarray, lam_j: np.ndarray
+) -> tuple[np.ndarray, np.ndarray]:
+    """a'nın b'ye uyguladığı kuvvet ve eklem noktası etrafındaki moment, eklemin a çerçevesinde.
+
+    Cisme gelen kısıt kuvveti Aᵀλ = [F, M_t] (M_t: bileşen orijini t etrafında);
+    eklem noktası p etrafında  M_p = M_t − (p − t) × F.
+    """
+    pa, za, xa = _cerceve(asm, j, "a")
+    pb, _, _ = _cerceve(asm, j, "b")
+    a, b = j.a.component, j.b.component
+    if b in unknowns:
+        i, p, isaret = unknowns.index(b), pb, 1.0
+        t_ = asm.component(b).T[:3, 3]
+    elif a in unknowns:  # b sabit: b'ye gelen kuvvet = −(a'ya gelen)
+        i, p, isaret = unknowns.index(a), pa, -1.0
+        t_ = asm.component(a).T[:3, 3]
+    else:
+        return np.zeros(3), np.zeros(3)
+    W = Aj[:, 6 * i : 6 * i + 6].T @ lam_j
+    F, M_t = W[:3], W[3:]
+    M_p = M_t - np.cross(p - t_, F)
+    E = np.column_stack([xa, np.cross(za, xa), za])  # a çerçevesi: x_a, y_a = z_a × x_a, z_a
+    return isaret * (E.T @ F), isaret * (E.T @ M_p)
 
 
