diff --git a/tezgah/arayuz/src/ekranlar/plan.ts b/tezgah/arayuz/src/ekranlar/plan.ts
new file mode 100644
index 0000000..f54fe49
--- /dev/null
+++ b/tezgah/arayuz/src/ekranlar/plan.ts
@@ -0,0 +1,393 @@
+// SPEC 47a — Plan ekranı: otomatik CAM planı (SPEC 29). Özellik listesi (önce planlanamayanlar), takım
+// kapatıp "Ne olurdu?" farkı, doğrulama ve freze / torna ekranında açma. Hesap yapmaz: her sayı sunucudan.
+// Sahneye yalnız "plan" katmanına çizer (parça ağı ya da özellik geometrisi).
+
+import * as THREE from "three";
+import type { Kontrol } from "../tipler";
+import { type Fark, farkRozetleri, gerekceMetni, ozellikSirala } from "./plan_yardim";
+import type { EkranModulu, Kabuk, Komut } from "./tip";
+
+const AD = "plan";
+
+interface Ozellik {
+  adres: string;
+  tur: string;
+  durum: "planlandi" | "planlanamadi";
+  islemler: string[];
+  kod?: string;
+  geometri: Record<string, unknown>;
+}
+
+interface Takim {
+  id: number;
+  ad: string;
+  tur: string;
+  D: number | null;
+  acik: boolean;
+}
+
+interface Plan {
+  sema: number;
+  ad: string;
+  tur: "freze" | "torna";
+  malzeme: string;
+  baglamalar: { i: number; wcs: string }[];
+  ozellikler: Ozellik[];
+  islemler: { name: string; kind: string; setup?: number; feature: string; tool_id: number; sure: number }[];
+  planlanamayan: { adres: string; kod: string; detay: string; metin: string }[];
+  notlar: { adres: string; kod: string; deger: number; detay: string; metin: string }[];
+  takim_degisimi: number;
+  takimlar: Takim[];
+  secenekler: Record<string, number | boolean | null>;
+  dogrulama: Record<string, unknown> | null;
+  gcode: string[][];
+  kontroller: Kontrol[];
+}
+
+interface Ornek {
+  ad: string;
+  tur: string;
+  aciklama: string;
+  hazir: boolean;
+  neden: string | null;
+}
+
+interface Durum {
+  K: Kabuk | null;
+  alan: HTMLElement | null;
+  ornekler: Ornek[];
+  ad: string;
+  plan: Plan | null;
+  fark: Fark | null;
+  secili: string | null;
+  mesgul: boolean;
+  hata: string | null;
+}
+
+const D: Durum = {
+  K: null,
+  alan: null,
+  ornekler: [],
+  ad: "",
+  plan: null,
+  fark: null,
+  secili: null,
+  mesgul: false,
+  hata: null,
+};
+
+function el<K extends keyof HTMLElementTagNameMap>(
+  etiket: K,
+  ozellik: Record<string, string> = {},
+  ...cocuk: (Node | string)[]
+): HTMLElementTagNameMap[K] {
+  const e = document.createElement(etiket);
+  for (const [k, v] of Object.entries(ozellik)) e.setAttribute(k, v);
+  e.append(...cocuk);
+  return e;
+}
+
+function sure(s: number): string {
+  return s >= 60 ? `${Math.floor(s / 60)} dk ${Math.round(s % 60)} s` : `${s.toFixed(1)} s`;
+}
+
+// ---------------------------------------------------------------- sunucu
+
+async function yukle(ad: string): Promise<void> {
+  const K = D.K!;
+  D.ad = ad;
+  D.fark = null;
+  D.secili = null;
+  D.hata = null;
+  D.plan = await K.api.getJson<Plan>(`/${ad}`);
+  await sahneCiz();
+  ciz();
+}
+
+async function istek(f: () => Promise<void>): Promise<void> {
+  if (D.mesgul) return;
+  D.mesgul = true;
+  D.hata = null;
+  ciz();
+  try {
+    await f();
+  } catch (e) {
+    D.hata = e instanceof Error ? e.message : String(e);
+  } finally {
+    D.mesgul = false;
+    ciz();
+  }
+}
+
+function neOlurdu(govde: Record<string, unknown>, etiket: string): Promise<void> {
+  return istek(async () => {
+    const r = await D.K!.api.postJson<{ plan: Plan; fark: Fark }>(`/${D.ad}/ne_olurdu`, govde, etiket);
+    D.plan = r.plan;
+    D.fark = r.fark;
+  });
+}
+
+function takimDegistir(t: Takim): Promise<void> {
+  const govde = t.acik ? { takim_kapat: [t.id] } : { takim_ac: [t.id] };
+  return neOlurdu(govde, `${t.acik ? "Kapat" : "Aç"}: T${t.id} ${t.ad}`);
+}
+
+function dogrula(): Promise<void> {
+  return istek(async () => {
+    D.plan = await D.K!.api.postJson<Plan>(`/${D.ad}/dogrula`, {}, "Planı doğrula");
+  });
+}
+
+function ac(bag: number): Promise<void> {
+  return istek(async () => {
+    const r = await D.K!.api.postJson<{ adres: string }>(`/${D.ad}/ac`, { bag }, `Aç: bağlama ${bag + 1}`);
+    D.K!.git(r.adres);
+  });
+}
+
+// ---------------------------------------------------------------- sahne
+
+function temizle(g: THREE.Group): void {
+  for (const c of [...g.children]) {
+    g.remove(c);
+    c.traverse((o) => {
+      const m = o as THREE.Mesh;
+      m.geometry?.dispose();
+      const mat = m.material as THREE.Material | THREE.Material[] | undefined;
+      if (Array.isArray(mat)) for (const x of mat) x.dispose();
+      else mat?.dispose();
+    });
+  }
+}
+
+function cizgi(noktalar: number[][], z: number, renk: number, kapali = true): THREE.Line {
+  const p = noktalar.map(([x, y]) => new THREE.Vector3(x, y, z));
+  const g = new THREE.BufferGeometry().setFromPoints(p);
+  const m = new THREE.LineBasicMaterial({ color: renk });
+  return kapali ? new THREE.LineLoop(g, m) : new THREE.Line(g, m);
+}
+
+function renk(oz: Ozellik): number {
+  if (oz.durum === "planlanamadi") return 0xe5484d;
+  return oz.adres === D.secili ? 0xffb224 : 0x5eb1ef;
+}
+
+async function sahneCiz(): Promise<void> {
+  const K = D.K!;
+  const g = K.sahne.katman(AD);
+  temizle(g);
+  const P = D.plan;
+  if (P === null) return;
+  if (P.tur === "freze") {
+    try {
+      const b = await K.api.getIkili(`/${P.ad}/ag`);
+      g.add(agMesh(b));
+    } catch {
+      // parçasız örnek (özellik kaydından plan): yalnız özellik geometrisi çizilir
+    }
+  }
+  ozellikCiz(g, P);
+}
+
+function agMesh(b: ArrayBuffer): THREE.Mesh {
+  const [nv, nt] = new Uint32Array(b, 0, 2);
+  const V = new Float32Array(b, 8, nv * 3);
+  const T = new Uint32Array(b, 8 + 12 * nv, nt * 3);
+  const geo = new THREE.BufferGeometry();
+  geo.setAttribute("position", new THREE.BufferAttribute(V, 3));
+  geo.setIndex(new THREE.BufferAttribute(T, 1));
+  geo.computeVertexNormals();
+  const mat = new THREE.MeshStandardMaterial({ color: 0x9aa4b2, transparent: true, opacity: 0.35 });
+  return new THREE.Mesh(geo, mat);
+}
+
+function ozellikCiz(g: THREE.Group, P: Plan): void {
+  const ust = new THREE.Group();
+  ust.name = "ozellikler";
+  for (const oz of P.ozellikler) {
+    const G = oz.geometri as Record<string, unknown>;
+    const r = renk(oz);
+    if (Array.isArray(G.dis)) {
+      const z = Number(G.z_alt);
+      ust.add(cizgi(G.dis as number[][], z, r));
+      ust.add(cizgi(G.dis as number[][], Number(G.z_ust), r));
+      for (const a of (G.adalar as number[][][]) ?? []) ust.add(cizgi(a, z, r));
+    } else if (Array.isArray(G.merkez)) {
+      const [x, y, z] = G.merkez as number[];
+      const [ax, ay, az] = G.eksen as number[];
+      const L = Number(G.derinlik);
+      const p = [new THREE.Vector3(x, y, z), new THREE.Vector3(x + ax * L, y + ay * L, z + az * L)];
+      ust.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(p), new THREE.LineBasicMaterial({ color: r })));
+      const n = 24;
+      const R = Number(G.D) / 2;
+      const daire = Array.from({ length: n }, (_, k) => [
+        x + R * Math.cos((2 * Math.PI * k) / n),
+        y + R * Math.sin((2 * Math.PI * k) / n),
+      ]);
+      ust.add(cizgi(daire, z, r));
+    } else if (Array.isArray(G.profil)) {
+      // torna: [x, z] → sahnede (z, x) yarı kesit
+      const p = (G.profil as number[][]).map(([xr, zz]) => [zz, xr]);
+      ust.add(cizgi(p, 0, r, false));
+    }
+  }
+  g.add(ust);
+}
+
+// ---------------------------------------------------------------- paneller
+
+function ozellikListesi(P: Plan): HTMLElement {
+  const liste = el("ol", { class: "plan-ozellikler" });
+  for (const oz of ozellikSirala(P.ozellikler)) {
+    const metin = oz.durum === "planlanamadi" && oz.kod ? gerekceMetni(oz.kod) : oz.islemler.join(", ");
+    const li = el(
+      "li",
+      { class: `plan-ozellik ${oz.durum}${oz.adres === D.secili ? " secili" : ""}`, "data-adres": oz.adres },
+      el("b", {}, oz.adres),
+      " ",
+      el("span", {}, metin),
+    );
+    li.addEventListener("click", () => sec(oz.adres));
+    liste.append(li);
+  }
+  return liste;
+}
+
+function takimListesi(P: Plan): HTMLElement {
+  const kutu = el("div", { class: "plan-takimlar" }, el("h3", {}, "Takımlar (Ne olurdu?)"));
+  for (const t of P.takimlar) {
+    const cb = el("input", { type: "checkbox", "data-takim": String(t.id) });
+    cb.checked = t.acik;
+    cb.disabled = D.mesgul;
+    cb.addEventListener("change", () => void takimDegistir(t));
+    const D_ = t.D === null ? "" : ` Ø${t.D}`;
+    kutu.append(el("label", { class: "plan-takim" }, cb, ` T${t.id} ${t.ad}${D_}`));
+  }
+  return kutu;
+}
+
+function farkPaneli(): HTMLElement | null {
+  if (D.fark === null) return null;
+  const kutu = el("div", { class: "plan-fark" }, el("h3", {}, "Fark"));
+  for (const r of farkRozetleri(D.fark)) {
+    kutu.append(el("span", { class: `rozet ${r.tur}`, "data-isaret": r.isaret }, r.metin));
+  }
+  return kutu;
+}
+
+function eylemler(P: Plan): HTMLElement {
+  const kutu = el("div", { class: "plan-eylemler" });
+  const dg = el("button", {}, P.dogrulama ? "Yeniden doğrula" : "Doğrula (simülasyon)");
+  dg.disabled = D.mesgul;
+  dg.addEventListener("click", () => void dogrula());
+  kutu.append(dg);
+  const hedef = P.tur === "torna" ? "Torna" : "Freze";
+  for (const b of P.baglamalar) {
+    const d = el("button", {}, `${hedef} ekranında aç: bağlama ${b.i + 1} (${b.wcs})`);
+    d.disabled = D.mesgul;
+    d.addEventListener("click", () => void ac(b.i));
+    kutu.append(d);
+  }
+  return kutu;
+}
+
+function ozet(P: Plan): HTMLElement {
+  const toplam = P.islemler.reduce((s, x) => s + x.sure, 0);
+  return el(
+    "p",
+    { class: "plan-ozet" },
+    `${P.islemler.length} işlem · ${sure(toplam)} · ${P.takim_degisimi} takım değişimi · ` +
+      `${P.planlanamayan.length} planlanamayan`,
+  );
+}
+
+function ciz(): void {
+  const { K, alan } = D;
+  if (K === null || alan === null) return;
+  alan.replaceChildren();
+  const secim = el("select", { class: "plan-ornek" });
+  for (const o of D.ornekler) {
+    const s = el("option", { value: o.ad }, o.hazir ? o.aciklama : `${o.aciklama} (${o.neden})`);
+    s.disabled = !o.hazir;
+    s.selected = o.ad === D.ad;
+    secim.append(s);
+  }
+  secim.addEventListener("change", () => void istek(() => yukle(secim.value)));
+  alan.append(secim);
+  if (D.hata) alan.append(el("p", { class: "hata" }, D.hata));
+  const P = D.plan;
+  if (P === null) return;
+  alan.append(ozet(P), ozellikListesi(P));
+  const muf = el("div", { class: "plan-mufettis" }, takimListesi(P));
+  const f = farkPaneli();
+  if (f) muf.append(f);
+  muf.append(eylemler(P));
+  K.mufettis(muf);
+  K.kanitlar(P.kontroller);
+  const uyari = P.kontroller.filter((k) => k.durum !== "tamam").length;
+  K.rozet(AD, uyari ? `${uyari} uyarı` : null);
+  K.kanca[AD] = { ad: D.ad, plan: P, fark: D.fark, mesgul: D.mesgul, hata: D.hata };
+  ozellikRenkleri();
+}
+
+function ozellikRenkleri(): void {
+  const P = D.plan;
+  const g = D.K?.sahne.katman(AD).getObjectByName("ozellikler");
+  if (!P || !g) return;
+  g.parent?.remove(g);
+  temizle(g as THREE.Group);
+  ozellikCiz(D.K!.sahne.katman(AD), P);
+}
+
+function sec(adres: string): void {
+  D.secili = D.secili === adres ? null : adres;
+  ciz();
+}
+
+function komutlar(): Komut[] {
+  const K: Komut[] = [
+    { kimlik: "plan.dogrula", baslik: "Planı doğrula", ekran: AD, calistir: () => dogrula() },
+    {
+      kimlik: "plan.rest",
+      baslik: "Kalan malzeme işlemlerini aç / kapat",
+      ekran: AD,
+      calistir: () => neOlurdu({ secenek: { rest: !(D.plan?.secenekler.rest ?? true) } }, "Kalan malzeme"),
+    },
+  ];
+  for (const o of D.ornekler.filter((x) => x.hazir)) {
+    K.push({ kimlik: `plan.ornek.${o.ad}`, baslik: `Plan: ${o.aciklama}`, ekran: AD, calistir: () => yukle(o.ad) });
+  }
+  return K;
+}
+
+const ekran: EkranModulu = {
+  ad: AD,
+  baslik: "Plan",
+  tus: "4",
+  async ac(alan: HTMLElement, kabuk: Kabuk, secim?: string): Promise<void> {
+    D.K = kabuk;
+    D.alan = alan;
+    const r = await kabuk.api.getJson<{ ornekler: Ornek[] }>("/ornekler");
+    D.ornekler = r.ornekler;
+    const istenen = new URLSearchParams(secim ?? "").get("ornek");
+    const ilk = D.ornekler.find((o) => o.ad === istenen && o.hazir) ?? D.ornekler.find((o) => o.hazir);
+    if (ilk) await yukle(ilk.ad);
+    else ciz();
+  },
+  kapat(): void {
+    if (D.K) {
+      temizle(D.K.sahne.katman(AD));
+      D.K.sahne.katmanBirak(AD);
+    }
+    D.alan?.replaceChildren();
+    D.K = null;
+    D.alan = null;
+  },
+  async tazele(): Promise<void> {
+    if (D.K && D.ad) await yukle(D.ad);
+  },
+  komutlar,
+  sec,
+};
+
+export default ekran;
diff --git a/tezgah/arayuz/src/ekranlar/plan_yardim.ts b/tezgah/arayuz/src/ekranlar/plan_yardim.ts
index 0e9ddc3..c865595 100644
--- a/tezgah/arayuz/src/ekranlar/plan_yardim.ts
+++ b/tezgah/arayuz/src/ekranlar/plan_yardim.ts
@@ -16,17 +16,58 @@ export interface Rozet {
   metin: string;
 }
 
+// SPEC 29 §1 kodlarının düz Türkçesi (sunucudaki GEREKCE_METNI / NOT_METNI ile aynı).
+const METIN: Readonly<Record<string, string>> = {
+  kesme_verisi_yok: "Bu türde, bu malzeme için kesme verisi olan takım yok",
+  takim_yok: "Uygun tür, çap ya da genişlikte takım yok",
+  takim_sigmiyor: "Aday takımların hiçbiri bölgeye sığmıyor",
+  kesici_boy_yetmez: "Sığan takımların kesici boyu derinliğe yetmiyor",
+  ustten_erisilemez: "Delik ekseni −Z değil: üstten erişilemez",
+  havsa_takimi_yok: "Havşa takımı yok: delik açılır, havşa açılmaz",
+  kilavuz_cevrimi_yok: "Kılavuz çevrimi (G84) yok: yalnız kılavuz matkabı deliği açılır",
+  baglama_carpismasi: "İşlem bağlama elemanına çarpıyor",
+  on_delik_yok: "Ham malzeme dolu: iç profil için ön delik yok",
+  genel_girinti: "Profilli kanal işlemi yok",
+  kose_artigi: "Köşede kalan malzeme",
+  yan_paso_kisildi: "Yan paso kısıldı",
+  delik_tasma_kisildi: "Delik taşması kısıldı",
+  ikinci_baglama: "Alt yüz için ikinci bağlama",
+};
+
 /** SPEC 29 §1 gerekçe ve not kodu → düz Türkçe metin. Bilinmeyen kod → Error (sessiz yok). */
-export function gerekceMetni(_kod: string): string {
-  throw new Error("SPEC 47a: gerekceMetni uygulanmadı");
+export function gerekceMetni(kod: string): string {
+  if (!Object.hasOwn(METIN, kod)) throw new Error(`Bilinmeyen gerekçe / not kodu: ${JSON.stringify(kod)}`);
+  return METIN[kod];
+}
+
+function isaret(x: number): "+" | "−" | "0" {
+  return x > 0 ? "+" : x < 0 ? "−" : "0";
 }
 
 /** Fark → rozet listesi (sunucunun sayıları; işaret yalnız sayının işaretidir, 0 → "0"). */
-export function farkRozetleri(_fark: Fark): Rozet[] {
-  throw new Error("SPEC 47a: farkRozetleri uygulanmadı");
+export function farkRozetleri(fark: Fark): Rozet[] {
+  const r: Rozet[] = [];
+  for (const ad of fark.eklenen) r.push({ tur: "eklendi", isaret: "+", metin: `${ad} eklendi` });
+  for (const ad of fark.cikan) r.push({ tur: "cikti", isaret: "−", metin: `${ad} çıktı` });
+  for (const t of fark.takimi_degisen) {
+    r.push({ tur: "takim", isaret: "~", metin: `${t.adres}: T${t.once} → T${t.sonra}` });
+  }
+  for (const p of fark.yeni_planlanamayan) {
+    r.push({ tur: "planlanamadi", isaret: "−", metin: `${p.adres} planlanamadı: ${gerekceMetni(p.kod)}` });
+  }
