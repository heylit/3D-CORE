+    n = len(satirlar[0]) if m else 0
+    if m < 4 or n < 4:
+        raise GeometryError(f"nokta ağı en az 4 × 4 olmalı ({m} × {n})")
+    if any(len(r) != n for r in satirlar):
+        raise GeometryError("nokta ağı düzensiz (satır uzunlukları farklı)")
